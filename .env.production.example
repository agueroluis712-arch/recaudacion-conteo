# Copiar como .env.production. Nunca subir el archivo real al repositorio.
DJANGO_SECRET_KEY=reemplazar-por-una-clave-aleatoria-de-al-menos-50-caracteres
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=recaudacion.example.gob.ar
DJANGO_CSRF_TRUSTED_ORIGINS=https://recaudacion.example.gob.ar
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

DB_ENGINE=postgresql
DB_NAME=recaudacion
DB_USER=recaudacion
DB_PASSWORD=reemplazar-por-una-clave-de-base-de-datos-segura
DB_HOST=db
DB_PORT=5432

APP_TIME_ZONE=America/Argentina/Buenos_Aires
APP_PUBLIC_URL=https://recaudacion.example.gob.ar
APP_PORT=8080
PUBLICATION_DELAY_MINUTES=30
MAX_UPLOAD_SIZE_MB=10

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=ARCAT Recaudación <no-reply@example.gob.ar>
EMAIL_HOST=smtp.example.gob.ar
EMAIL_PORT=587
EMAIL_HOST_USER=reemplazar
EMAIL_HOST_PASSWORD=reemplazar
EMAIL_USE_TLS=true
PASSWORD_RESET_TIMEOUT=3600
