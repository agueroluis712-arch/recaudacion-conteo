DJANGO_SECRET_KEY=cambiar-en-cada-instalacion
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000

DB_ENGINE=postgresql
DB_NAME=recaudacion
DB_USER=recaudacion
DB_PASSWORD=cambiar-esta-clave
DB_HOST=db
DB_PORT=5432

APP_TIME_ZONE=America/Argentina/Buenos_Aires
PUBLICATION_DELAY_MINUTES=30
MAX_UPLOAD_SIZE_MB=10

APP_PUBLIC_URL=http://localhost:5173
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Recaudación <no-reply@localhost>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
PASSWORD_RESET_TIMEOUT=3600
